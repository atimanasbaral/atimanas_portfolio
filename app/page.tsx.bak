"use client";
import { useEffect, useRef, useState } from "react";
import Link from "next/link";
import { motion, AnimatePresence } from "framer-motion";
import dynamic from "next/dynamic";
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

gsap.registerPlugin(ScrollTrigger);
import IntroSequence from "@/components/IntroSequence";
import CountUp from "@/components/effects/CountUp";
import { profile } from "@/lib/data/profile";
import { lorePreviewPanels } from "@/lib/data/lore";
import {
  Sparkles,
  Flame,
  Search,
  Rocket,
  Flag,
  BarChart3,
  Brain,
  Code2,
  Globe,
  Cloud,
  Trophy,
  Star,
  Clock,
  Award,
  Mail,
  Calendar,
  Download,
  type LucideIcon,
} from "lucide-react";

const CyberpunkScene = dynamic(() => import("../components/CyberpunkScene"), { ssr: false });

const ROLES = [
  "Data Engineer",
  "AI / ML Engineer",
  "Quant-Curious Analyst",
  "Builder of Things That Ship",
];

const FEATURED_PROJECTS = [
  {
    title: "Agrivoltaic System Automation",
    description: "Weather-aware solar forecasting dashboard with simulated energy analytics.",
    tags: ["Python", "TensorFlow", "IoT", "Power BI"],
    gradient: "linear-gradient(135deg, rgba(102,204,255,0.28), rgba(36,107,255,0.18))",
  },
  {
    title: "Real-Time Stock Prediction",
    description: "Trading terminal concept with momentum, risk, signals, and backtesting.",
    tags: ["Python", "Pandas", "Scikit-Learn", "APIs"],
    gradient: "linear-gradient(135deg, rgba(109,74,255,0.3), rgba(102,204,255,0.12))",
  },
  {
    title: "AI Notebook Application",
    description: "Mini productivity SaaS with notes, tasks, and AI assistant workflow.",
    tags: ["Flutter", "Firebase", "SQLite", "Hive"],
    gradient: "linear-gradient(135deg, rgba(109,74,255,0.22), rgba(255,255,255,0.06))",
  },
];

const STORY_IMAGES = ["q1-circuit", "q3-code", "q2-quant", "arena-crop", "q4-mission"];
const STORY_ICONS = [Sparkles, Flame, Search, Rocket, Flag];
const STORY_PANELS = lorePreviewPanels.map((panel, index) => ({
  ...panel,
  icon: STORY_ICONS[index] ?? Flag,
  image: STORY_IMAGES[index] ?? "q1-circuit",
}));

const SKILLS = [
  { label: "Data Analytics", tools: "Python, SQL, Power BI, Tableau, Excel", level: 95, icon: BarChart3 },
  { label: "Machine Learning", tools: "Scikit-Learn, TensorFlow, PyTorch, OpenCV", level: 90, icon: Brain },
  { label: "Programming", tools: "Python, C++, SQL, JavaScript, TypeScript", level: 85, icon: Code2 },
  { label: "Web Development", tools: "Next.js, React, Tailwind, Node.js", level: 80, icon: Globe },
  { label: "Cloud & DevOps", tools: "AWS, Azure, Docker, Git, CI/CD", level: 75, icon: Cloud },
];

const CERTIFICATIONS = [
  { name: "HSBC", subtitle: "Job Simulation", mark: "HSBC", accent: "#DB0011" },
  { name: "J.P. Morgan", subtitle: "Quantitative Research", mark: "JPM", accent: "#247BC1" },
  { name: "Microsoft", subtitle: "Data Analytics Certification", mark: "MS", accent: "#00A4EF" },
  { name: "Google", subtitle: "AI Essentials", mark: "G", accent: "#00d4ff" },
];

const STATS = [
  { value: "15+", label: "Projects Completed", icon: Rocket },
  { value: "10+", label: "Certifications Earned", icon: Trophy },
  { value: "5+", label: "Internships & Experience", icon: Star },
  { value: "1000+", label: "Hours Of Learning", icon: Clock },
];

export default function Home() {
  const [showIntro, setShowIntro] = useState(false);
  const [checked, setChecked] = useState(false);
  const [roleIndex, setRoleIndex] = useState(0);

  const heroRef = useRef<HTMLDivElement>(null);
  const heroBgRef = useRef<HTMLDivElement>(null);
  const heroCharRef = useRef<HTMLDivElement>(null);
  const heroBubbleRef = useRef<HTMLDivElement>(null);
  const tearRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    queueMicrotask(() => {
      const seen = localStorage.getItem("hasSeenIntro");
      setShowIntro(!seen);
      setChecked(true);
    });
  }, []);

  useEffect(() => {
    const id = setInterval(() => {
      setRoleIndex((i) => (i + 1) % ROLES.length);
    }, 2400);
    return () => clearInterval(id);
  }, []);

  // Scrollytelling: parallax depth on the hero layers + a torn-paper
  // "page tear" that peels away as you scroll from the hero into My Story.
  useEffect(() => {
    if (!checked || showIntro) return;
    if (!heroRef.current) return;

    const triggers: ScrollTrigger[] = [];

    if (heroBgRef.current) {
      triggers.push(
        gsap.to(heroBgRef.current, {
          yPercent: 18,
          ease: "none",
          scrollTrigger: { trigger: heroRef.current, start: "top top", end: "bottom top", scrub: true },
        }).scrollTrigger as ScrollTrigger
      );
    }
    if (heroCharRef.current) {
      triggers.push(
        gsap.to(heroCharRef.current, {
          yPercent: -8,
          ease: "none",
          scrollTrigger: { trigger: heroRef.current, start: "top top", end: "bottom top", scrub: true },
        }).scrollTrigger as ScrollTrigger
      );
    }
    if (heroBubbleRef.current) {
      triggers.push(
        gsap.to(heroBubbleRef.current, {
          scale: 0.7,
          opacity: 0,
          y: -40,
          ease: "none",
          scrollTrigger: { trigger: heroRef.current, start: "top top", end: "55% top", scrub: true },
        }).scrollTrigger as ScrollTrigger
      );
    }
    if (tearRef.current) {
      triggers.push(
        gsap.fromTo(
          tearRef.current,
          { yPercent: 0 },
          {
            yPercent: -130,
            ease: "none",
            scrollTrigger: { trigger: tearRef.current, start: "top 95%", end: "top 25%", scrub: true },
          }
        ).scrollTrigger as ScrollTrigger
      );
    }

    ScrollTrigger.refresh();

    return () => {
      triggers.forEach((t) => t?.kill());
    };
  }, [checked, showIntro]);

  if (!checked) return <div className="min-h-screen" style={{ background: "var(--color-bg-primary)" }} />;
  if (showIntro) return <IntroSequence onComplete={() => setShowIntro(false)} />;

  return (
    <div className="relative min-h-screen overflow-hidden bg-bg-primary">
        <section ref={heroRef} className="relative flex min-h-screen items-center overflow-hidden bg-hero-gradient light-lake-bg">

          <div ref={heroBgRef} className="absolute inset-0 z-0">
            <div className="absolute inset-0 opacity-40" style={{ pointerEvents: "none" }}>
              <CyberpunkScene />
            </div>
            <div className="halftone-dots-light absolute inset-0 opacity-30" />

            <div className="absolute inset-0" style={{
              background: "repeating-conic-gradient(from 0deg at 72% 40%, rgba(255,255,255,0.16) 0deg 1.2deg, transparent 1.2deg 9deg)",
              maskImage: "radial-gradient(circle at 72% 40%, rgba(0,0,0,0.9) 0%, transparent 62%)",
              WebkitMaskImage: "radial-gradient(circle at 72% 40%, rgba(0,0,0,0.9) 0%, transparent 62%)",
            }} />
            <div className="absolute bottom-0 left-0 right-0 h-72 opacity-70" style={{ backgroundImage: "linear-gradient(to top, var(--color-bg-primary) 0%, transparent 100%)" }} />
            <div className="absolute bottom-0 left-0 right-0 flex h-64 items-end gap-2 px-8 opacity-70">
              {Array.from({ length: 38 }).map((_, i) => (
                <div key={i} className="relative flex-1"
                  style={{ height: `${52 + (i * 37) % 180}px`, background: "var(--color-bg-elevated)", borderTop: "1px solid rgba(102,204,255,0.28)" }}>
                  <div className="absolute inset-2 opacity-60"
                    style={{ backgroundImage: "linear-gradient(var(--color-accent-violet) 2px, transparent 2px)", backgroundSize: "100% 18px" }} />
                </div>
              ))}
            </div>
          </div>

          <div ref={heroCharRef} className="absolute right-24 bottom-0 z-10 h-[90%] w-auto hidden md:block">
            <img src="/avatar.png" alt="Atimanas Baral" className="h-full w-auto object-contain object-bottom"
              style={{ filter: "drop-shadow(6px 10px 0 rgba(0,0,0,0.55))" }} />
          </div>

          <motion.div ref={heroBubbleRef} className="absolute z-20 hidden lg:block" style={{ right: "22rem", top: "8rem" }}
            initial={{ opacity: 0, scale: 0.8 }} animate={{ opacity: 1, scale: 1 }} transition={{ delay: 1, duration: 0.5 }}>
            <div className="speech-bubble relative max-w-[220px] px-7 py-6 text-center text-lg font-black uppercase leading-snug">
              Data is not just numbers. It is the blueprint of the future.
            </div>
          </motion.div>

          <div className="absolute top-20 right-4 z-20 hidden xl:flex flex-col gap-2">
            {["q1-circuit", "q2-quant", "q3-code"].map((file, n) => (
              <div key={file} className="ink-frame relative w-16 h-20 overflow-hidden"
                style={{ background: "var(--color-bg-surface)", transform: `rotate(${(n - 1) * 4}deg)` }}>
                <img src={`/manga/${file}.png`} alt="" className="w-full h-full object-cover" />
              </div>
            ))}
          </div>

          <div className="relative z-20 px-8 md:px-12 max-w-2xl">
            <motion.div className="mb-4 w-fit -skew-x-12 px-5 py-2"
              style={{ background: "linear-gradient(90deg, var(--color-accent-violet), rgba(36,107,255,0.2))" }}
              initial={{ opacity: 0, x: -20 }} animate={{ opacity: 1, x: 0 }} transition={{ duration: 0.5 }}>
              <span className="block skew-x-12 text-sm font-black uppercase tracking-widest text-white">Hello, I am</span>
            </motion.div>
            <motion.h1 className="font-display leading-none mb-2"
              style={{ fontSize: "clamp(3.5rem, 9vw, 7rem)", color: "var(--color-text-primary)" }}
              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.6, delay: 0.1 }}>
              ATIMANAS
            </motion.h1>
            <motion.h1 className="font-display leading-none mb-6"
              style={{ fontSize: "clamp(3.5rem, 9vw, 7rem)", color: "var(--color-accent-violet)", textShadow: "4px 4px 0 rgba(0,0,0,0.6)" }}
              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.6, delay: 0.2 }}>
              BARAL
            </motion.h1>
            <motion.p className="text-lg font-semibold mb-2" style={{ color: "var(--color-text-primary)" }}
              initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ delay: 0.4 }}>
              DATA ANALYST | AI ENGINEER
            </motion.p>
            <motion.p className="text-lg font-semibold mb-2" style={{ color: "var(--color-text-primary)" }}
              initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ delay: 0.5 }}>
              MACHINE LEARNING ENTHUSIAST
            </motion.p>
            <motion.div className="h-7 overflow-hidden mb-6" initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ delay: 0.6 }}>
              <AnimatePresence mode="wait">
                <motion.p key={roleIndex} initial={{ opacity: 0, y: 14 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -14 }}
                  transition={{ duration: 0.3 }} className="text-sm" style={{ color: "var(--color-text-muted)" }}>
                  {ROLES[roleIndex]}
                </motion.p>
              </AnimatePresence>
            </motion.div>
            <motion.div className="flex gap-3 flex-wrap" initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.7 }}>
              <Link href="/projects" className="btn-primary">
                EXPLORE MY WORK
              </Link>
              <a href={profile.resumePath} download className="btn-outline">
                <Download size={16} strokeWidth={1.75} />
                DOWNLOAD RESUME
              </a>
            </motion.div>
            <motion.div className="mt-10 flex items-center gap-2" initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ delay: 1 }}>
              <div className="w-4 h-4 rounded-full border-2 flex items-center justify-center" style={{ borderColor: "var(--color-steel-light)" }}>
                <div className="w-1 h-1 rounded-full" style={{ background: "var(--color-steel-light)" }} />
              </div>
              <span className="text-xs tracking-widest" style={{ color: "var(--color-steel-light)" }}>SCROLL DOWN</span>
            </motion.div>
          </div>
        </section>

        <div className="relative h-0">
          <div ref={tearRef} className="absolute left-0 right-0 -top-1 z-30 h-56"
            style={{
              background: "#f5f5f0",
              clipPath: "polygon(0% 0%, 100% 0%, 100% 70%, 93% 80%, 86% 68%, 79% 82%, 72% 70%, 65% 84%, 58% 68%, 51% 82%, 44% 68%, 37% 84%, 30% 70%, 23% 82%, 16% 68%, 9% 80%, 0% 70%)",
            }}>
            <div className="halftone-dots absolute inset-0 opacity-20" />
            <div className="absolute bottom-10 left-1/2 -translate-x-1/2 text-center">
              <p className="font-display text-2xl tracking-wide text-black/80">Chapter One</p>
              <p className="mt-1 text-xs font-bold uppercase tracking-widest text-black/50">My Story Begins</p>
            </div>
          </div>
        </div>

        <section className="grid gap-6 px-6 py-10 md:grid-cols-[260px_1fr] md:px-12 light-jungle-bg"
          style={{ borderTop: "1px solid var(--color-border)", background: "linear-gradient(180deg, rgba(5,6,8,1), rgba(5,6,8,1))" }}>
          <div className="flex flex-col justify-between gap-6">
            <div>
              <motion.h2 className="font-display text-5xl leading-none" style={{ color: "var(--color-text-primary)", textShadow: "3px 3px 0 rgba(0,0,0,0.5)" }}
                initial={{ clipPath: "inset(0 100% 0 0)" }} whileInView={{ clipPath: "inset(0 0% 0 0)" }} viewport={{ once: true }}
                transition={{ duration: 0.7, ease: [0.16, 1, 0.3, 1] }}>MY STORY</motion.h2>
              <p className="mt-2 text-sm" style={{ color: "var(--color-text-primary)" }}>Every chapter shaped me.</p>
              <p className="mt-8 max-w-[220px] text-lg leading-snug" style={{ color: "var(--color-text-primary)" }}>
                From circuits to code to quant signals — each chapter shipped a real system, not just a résumé line.
              </p>
            </div>
            <a href="/lore" className="ink-frame group flex w-fit items-center gap-6 rounded px-6 py-4 text-xs font-bold uppercase tracking-widest"
              style={{ background: "var(--color-bg-elevated)", color: "var(--color-accent-violet)" }}>
              View Full Journey <span className="transition-transform group-hover:translate-x-1">-&gt;</span>
            </a>
          </div>
          <div>
            <div className="grid min-h-[300px] gap-2 md:grid-cols-5">
              {STORY_PANELS.map((panel, index) => {
                const Icon = panel.icon;
                return (
                  <motion.div key={panel.title}
                    className="ink-frame relative flex min-h-64 flex-col justify-end overflow-hidden"
                    initial={{ opacity: 0, y: 24 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }} transition={{ delay: index * 0.08 }}>
                    <img src={`/manga/${panel.image}.png`} alt={panel.title} className="absolute inset-0 h-full w-full object-cover" />
                    <div className="absolute inset-0" style={{ background: "linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.55) 38%, transparent 62%)" }} />
                    <div className="absolute right-2 top-2 flex h-7 w-7 items-center justify-center rounded-full border"
                      style={{ borderColor: "rgba(255,255,255,0.7)", background: "rgba(0,0,0,0.55)" }}>
                      <Icon size={14} strokeWidth={2.25} className="text-white" />
                    </div>
                    <div className="relative z-10 p-4">
                      <h3 className="font-display text-xl leading-none text-white">{panel.title}</h3>
                      <p className="mt-2 text-xs font-semibold leading-relaxed text-white/80">{panel.text}</p>
                      <p className="mt-2 text-sm font-bold text-white">{panel.year}</p>
                    </div>
                  </motion.div>
                );
              })}
            </div>
            <div className="relative mt-5 h-8">
              <div className="absolute left-0 right-0 top-3 h-0.5" style={{ background: "var(--color-text-primary)" }} />
              {STORY_PANELS.map((panel, index) => (
                <div key={panel.year} className="absolute top-1 h-5 w-5 rounded-full border-2"
                  style={{ left: `${index * 24}%`, background: "var(--color-accent-violet)", borderColor: "var(--color-text-primary)", boxShadow: "2px 2px 0 rgba(0,0,0,0.6)" }} />
              ))}
              <span className="absolute right-0 top-4 text-xs font-bold uppercase" style={{ color: "var(--color-text-primary)" }}>Future</span>
            </div>
          </div>
        </section>

        <section className="grid gap-8 px-6 py-12 md:px-12 xl:grid-cols-[360px_1fr_360px]"
          style={{ borderTop: "1px solid var(--color-border)", background: "var(--color-bg-surface)" }}>
          <div className="ink-frame relative min-h-[360px] overflow-hidden"
            style={{ background: "var(--color-bg-primary)" }}>
            <img src="/manga/full-analyzing-data.png" alt="Atimanas Baral analyzing data" className="absolute inset-0 h-full w-full object-cover" />
            <div className="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent" />
            <a href="/skills" className="ink-frame absolute bottom-8 left-1/2 flex -translate-x-1/2 items-center gap-5 rounded px-6 py-4 text-xs font-bold uppercase tracking-widest"
              style={{ color: "var(--color-text-primary)", background: "rgba(5,6,8,0.85)" }}>
              Explore Skills <span>-&gt;</span>
            </a>
          </div>
          <div className="space-y-6 py-3">
            {SKILLS.map((skill, index) => {
              const Icon = skill.icon;
              return (
                <motion.div key={skill.label} initial={{ opacity: 0, x: 18 }} whileInView={{ opacity: 1, x: 0 }} viewport={{ once: true }} transition={{ delay: index * 0.07 }}>
                  <div className="mb-2 flex items-center justify-between gap-4">
                    <div className="flex items-center gap-4">
                      <Icon size={22} strokeWidth={1.75} style={{ color: index % 2 ? "var(--color-accent-cyan)" : "var(--color-accent-violet)" }} />
                      <div>
                        <h3 className="text-sm font-bold uppercase tracking-widest" style={{ color: "var(--color-text-primary)" }}>{skill.label}</h3>
                        <p className="text-xs" style={{ color: "var(--color-text-muted)" }}>{skill.tools}</p>
                      </div>
                    </div>
                    <span className="text-sm font-bold" style={{ color: "var(--color-text-primary)" }}>{skill.level}%</span>
                  </div>
                  <div className="h-2 overflow-hidden rounded-full border" style={{ background: "var(--color-border)", borderColor: "var(--color-text-primary)" }}>
                    <motion.div className="h-full rounded-full"
                      style={{ background: "linear-gradient(90deg, var(--color-accent-violet), var(--color-accent-cyan))" }}
                      initial={{ width: 0 }} whileInView={{ width: `${skill.level}%` }} viewport={{ once: true }} transition={{ duration: 1, delay: index * 0.08 }} />
                  </div>
                </motion.div>
              );
            })}
          </div>
          <div className="ink-frame relative min-h-[360px] overflow-hidden"
            style={{ background: "var(--color-bg-elevated)" }}>
            <img src="/manga/q4-mission.png" alt="Atimanas Baral: I don't follow the crowd, I create my own path" className="absolute inset-0 h-full w-full object-cover" />
          </div>
        </section>

        <section className="px-8 py-12 md:px-12" style={{ borderTop: "1px solid var(--color-border)" }}>
          <div className="mb-6 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p className="text-xs tracking-widest uppercase" style={{ color: "var(--color-steel-light)" }}>Quest Log</p>
              <motion.h2 className="font-display text-4xl md:text-5xl" style={{ color: "var(--color-text-primary)" }}
                initial={{ clipPath: "inset(0 100% 0 0)" }} whileInView={{ clipPath: "inset(0 0% 0 0)" }} viewport={{ once: true }}
                transition={{ duration: 0.7, ease: [0.16, 1, 0.3, 1] }}>FEATURED PROJECTS</motion.h2>
            </div>
            <Link href="/projects" className="text-xs font-semibold tracking-widest transition-colors" style={{ color: "var(--color-accent-violet)" }}>
              VIEW ALL PROJECTS
            </Link>
          </div>
          <div className="grid gap-5 lg:grid-cols-3">
            {FEATURED_PROJECTS.map((project, index) => (
              <motion.a key={project.title} href="/projects"
                className="ink-frame group relative overflow-hidden rounded-lg p-5"
                style={{ background: "var(--color-bg-surface)" }}
                initial={{ opacity: 0, y: 18 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }}
                transition={{ duration: 0.4, delay: index * 0.08 }}>
                <div className="absolute inset-x-0 top-0 h-28 opacity-80" style={{ background: project.gradient }} />
                <div className="relative mb-5 h-40 overflow-hidden rounded-md border-2"
                  style={{ background: "var(--color-bg-surface)", borderColor: "var(--color-text-primary)" }}>
                  <div className="absolute inset-x-0 top-0 flex h-6 items-center gap-1.5 border-b px-3"
                    style={{ borderColor: "var(--color-border)", background: "rgba(5,6,8,0.6)" }}>
                    <span className="h-2 w-2 rounded-full" style={{ background: "#ff5f56" }} />
                    <span className="h-2 w-2 rounded-full" style={{ background: "#ffbd2e" }} />
                    <span className="h-2 w-2 rounded-full" style={{ background: "#27c93f" }} />
                  </div>
                  <div className="absolute inset-0 top-6 opacity-40"
                    style={{ backgroundImage: "linear-gradient(var(--color-border) 1px, transparent 1px), linear-gradient(90deg, var(--color-border) 1px, transparent 1px)", backgroundSize: "24px 24px" }} />
                  <div className="absolute left-4 right-4 top-11 flex items-end gap-2">
                    {Array.from({ length: 9 }).map((_, barIndex) => (
                      <motion.span key={barIndex} className="flex-1 rounded-t"
                        style={{ background: barIndex % 2 ? "var(--color-accent-cyan)" : "var(--color-accent-violet)" }}
                        animate={{ height: [34, 78 - barIndex * 4, 42 + barIndex * 5] }}
                        transition={{ duration: 2.4, repeat: Infinity, delay: barIndex * 0.08 }} />
                    ))}
                  </div>
                  <div className="absolute bottom-4 left-4 rounded border px-2 py-1 text-[10px] font-bold uppercase tracking-widest"
                    style={{ borderColor: "var(--color-accent-violet)", color: "var(--color-text-primary)", background: "rgba(5,6,8,0.75)" }}>
                    Live Demo
                  </div>
                </div>
                <h3 className="relative font-display text-2xl leading-tight" style={{ color: "var(--color-text-primary)" }}>{project.title}</h3>
                <p className="relative mt-2 text-sm" style={{ color: "var(--color-text-muted)" }}>{project.description}</p>
                <div className="relative mt-4 flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span key={tag} className="flex items-center gap-1.5 rounded border px-2 py-1 text-[11px]"
                      style={{ borderColor: "var(--color-border)", color: "var(--color-text-muted)" }}>
                      <Code2 size={11} strokeWidth={2} style={{ color: "var(--color-accent-violet)" }} />
                      {tag}
                    </span>
                  ))}
                </div>
                <div className="relative mt-5 flex items-center justify-between border-t pt-4" style={{ borderColor: "var(--color-border)" }}>
                  <span className="text-xs font-semibold tracking-widest" style={{ color: "var(--color-accent-violet)" }}>OPEN PROJECT WORLD</span>
                  <span className="transition-transform group-hover:translate-x-1" style={{ color: "var(--color-accent-violet)" }}>-&gt;</span>
                </div>
              </motion.a>
            ))}
          </div>
        </section>

        <section className="grid gap-10 px-6 py-12 md:px-12 xl:grid-cols-[1.15fr_1fr]"
          style={{ borderTop: "1px solid var(--color-border)", background: "var(--color-bg-surface)" }}>
          <div>
            <div className="mb-6 flex items-end gap-4">
              <motion.h2 className="font-display text-4xl md:text-5xl" style={{ color: "var(--color-text-primary)" }}
                initial={{ clipPath: "inset(0 100% 0 0)" }} whileInView={{ clipPath: "inset(0 0% 0 0)" }} viewport={{ once: true }}
                transition={{ duration: 0.7, ease: [0.16, 1, 0.3, 1] }}>CERTIFICATIONS</motion.h2>
              <p className="pb-2 text-xs" style={{ color: "var(--color-text-muted)" }}>Continuous learning. Continuous growth.</p>
            </div>
            <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {CERTIFICATIONS.map((cert, certIndex) => (
                <motion.div key={cert.name} className="ink-frame relative min-h-40 overflow-hidden rounded-lg p-5"
                  style={{ background: "linear-gradient(145deg, rgba(17,19,28,1), rgba(12,15,25,1))" }}
                  initial={{ opacity: 0, y: 24, rotate: -3 }}
                  whileInView={{ opacity: 1, y: 0, rotate: 0 }}
                  viewport={{ once: true }}
                  transition={{ delay: certIndex * 0.1, duration: 0.5, ease: [0.16, 1, 0.3, 1] }}>
                  <div className="absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full border-2"
                    style={{ borderColor: cert.accent, background: `${cert.accent}1a` }}>
                    <Award size={16} strokeWidth={2} style={{ color: cert.accent }} />
                  </div>
                  <h3 className="text-lg font-semibold" style={{ color: "var(--color-text-primary)" }}>{cert.name}</h3>
                  <p className="mt-1 text-xs" style={{ color: "var(--color-text-muted)" }}>{cert.subtitle}</p>
                  <p className="absolute bottom-5 left-5 font-display text-2xl" style={{ color: cert.accent }}>{cert.mark}</p>
                </motion.div>
              ))}
            </div>
          </div>
          <div className="xl:border-l xl:pl-12" style={{ borderColor: "var(--color-steel)" }}>
            <div className="mb-6">
              <motion.h2 className="font-display text-4xl md:text-5xl" style={{ color: "var(--color-text-primary)" }}
                initial={{ clipPath: "inset(0 100% 0 0)" }} whileInView={{ clipPath: "inset(0 0% 0 0)" }} viewport={{ once: true }}
                transition={{ duration: 0.7, ease: [0.16, 1, 0.3, 1] }}>STATS</motion.h2>
              <p className="text-xs" style={{ color: "var(--color-text-muted)" }}>Numbers that tell the story.</p>
            </div>
            <div className="grid gap-4 sm:grid-cols-2">
              {STATS.map((stat, index) => {
                const Icon = stat.icon;
                const color = index === 3 ? "#f7a928" : index === 2 ? "var(--color-accent-cyan)" : "var(--color-accent-violet)";
                return (
                  <motion.div key={stat.label} className="ink-frame rounded-lg p-6"
                    style={{ background: "linear-gradient(145deg, rgba(17,19,28,1), rgba(5,6,8,1))" }}
                    initial={{ opacity: 0, y: 18 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }} transition={{ delay: index * 0.08 }}>
                    <div className="mb-2 flex items-center justify-between">
                      <p className="font-display text-4xl" style={{ color }}><CountUp value={stat.value} /></p>
                      <motion.span initial={{ rotate: -45, scale: 0 }} whileInView={{ rotate: 0, scale: 1 }} viewport={{ once: true }}
                        transition={{ delay: index * 0.08 + 0.3, type: "spring", stiffness: 200, damping: 12 }}>
                        <Icon size={20} strokeWidth={1.75} style={{ color }} />
                      </motion.span>
                    </div>
                    <p className="mt-1 text-xs font-bold uppercase tracking-widest" style={{ color: "var(--color-text-primary)" }}>{stat.label}</p>
                  </motion.div>
                );
              })}
            </div>
          </div>
        </section>

        <section className="relative overflow-hidden px-8 py-16 md:px-12"
          style={{ borderTop: "1px solid var(--color-border)", background: "linear-gradient(120deg, rgba(36,107,255,0.18), rgba(102,204,255,0.08), rgba(5,6,8,1))" }}>
          <div className="absolute inset-0 opacity-10" style={{
            backgroundImage: "repeating-linear-gradient(115deg, rgba(255,255,255,0.5) 0px, rgba(255,255,255,0.5) 1px, transparent 1px, transparent 14px)",
          }} />
          <div className="relative z-10 flex flex-col gap-10 md:flex-row md:items-center md:justify-between">
            <div>
              <p className="text-xs tracking-widest uppercase" style={{ color: "var(--color-steel-light)" }}>Final Boss</p>
              <h2 className="font-display text-4xl md:text-5xl" style={{ color: "var(--color-text-primary)" }}>LETS BUILD SOMETHING AMAZING TOGETHER.</h2>
              <div className="mt-6 flex flex-wrap items-center gap-3">
                <a href={`mailto:${profile.email}`} className="btn-primary">LETS CONNECT</a>
                <a href="#" className="btn-outline" title="Add your Calendly/cal.com link here">
                  <Calendar size={16} strokeWidth={1.75} />
                  SCHEDULE A CALL
                </a>
                <motion.span className="sfx-text ml-2 hidden text-3xl md:inline-block"
                  initial={{ scale: 0, rotate: -20, opacity: 0 }}
                  whileInView={{ scale: 1, rotate: -4, opacity: 1 }}
                  viewport={{ once: true }}
                  transition={{ type: "spring", stiffness: 260, damping: 14, delay: 0.2 }}>DASH!</motion.span>
              </div>
            </div>
            <div className="flex flex-col gap-3 text-sm" style={{ color: "var(--color-text-muted)" }}>
              <a href={`mailto:${profile.email}`} className="flex items-center gap-3 transition-colors hover:text-accent-violet" style={{ color: "inherit" }}>
                <Mail size={16} strokeWidth={1.75} style={{ color: "var(--color-accent-cyan)" }} /> {profile.email}
              </a>
              {profile.linkedin ? (
                <a href={profile.linkedin} target="_blank" rel="noopener noreferrer"
                  className="flex items-center gap-3 transition-colors hover:text-accent-violet" style={{ color: "inherit" }}>
                  <span className="flex h-4 w-4 items-center justify-center text-[10px] font-bold" style={{ color: "var(--color-accent-cyan)" }}>in</span>
                  {profile.linkedin.replace("https://", "")}
                </a>
              ) : null}
              {profile.github ? (
                <a href={profile.github} target="_blank" rel="noopener noreferrer"
                  className="flex items-center gap-3 transition-colors hover:text-accent-violet" style={{ color: "inherit" }}>
                  <span className="flex h-4 w-4 items-center justify-center text-[10px] font-bold" style={{ color: "var(--color-accent-cyan)" }}>gh</span>
                  {profile.github.replace("https://", "")}
                </a>
              ) : null}
              <p className="text-xs opacity-0 hover:opacity-100 transition-opacity duration-500" style={{ color: "var(--color-text-faint)" }}>Let&apos;s create the future together!</p>
            </div>
          </div>
        </section>

        <div className="flex justify-center pb-6">
          <button onClick={() => { localStorage.removeItem("hasSeenIntro"); window.location.reload(); }}
            className="text-xs" style={{ color: "var(--color-text-faint)" }}>
            replay intro
          </button>
        </div>
    </div>
  );
}
